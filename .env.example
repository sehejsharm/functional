# URL of the Mise API (Cloudflare Worker), e.g. https://mise-api.<your-subdomain>.workers.dev
# Leave unset to run in demo mode (a sample hotel kept in the browser).
VITE_API_URL=http://localhost:8787
# Optional: shows a "Contact support" button in Help
VITE_SUPPORT_EMAIL=
# Demo mode only: replaces the published demo passkey
VITE_DEMO_PASSPHRASE=
